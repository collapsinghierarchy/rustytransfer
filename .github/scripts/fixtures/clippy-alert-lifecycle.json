      "name": "pake-finish-missing-errors-doc",
      "selector": {
        "path": "src/crypto/pake.rs",
        "rule_id": "clippy::missing_errors_doc",
        "source_needle": "pub fn finish(&mut self, inbound_msg: &[u8])"
      }
    },
    {
      "name": "kem-encapsulate-unwrap",
      "selector": {
        "path": "src/crypto/kem.rs",
        "rule_id": "clippy::unwrap_used",
        "source_needle": "ek.encapsulate(&mut self.rng).unwrap()"
      }
    },
    {
      "name": "webrtc-fragment-indexing",
      "selector": {
        "path": "src/transport/webrtc.rs",
        "rule_id": "clippy::indexing_slicing",
        "source_needle": "&c[0..4] == FRAG_MAGIC"
      }
    }
