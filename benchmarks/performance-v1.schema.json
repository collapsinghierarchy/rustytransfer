{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustytransfer.invalid/schemas/performance-v1.schema.json",
  "title": "Rustytransfer performance measurement v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "commit",
    "working_tree_dirty",
    "transport",
    "path",
    "path_start",
    "path_end",
    "size_bytes",
    "chunk_size",
    "pipeline_depth",
    "handshake_seconds",
    "payload_seconds",
    "shutdown_seconds",
    "wall_seconds",
    "effective_mib_per_second",
    "sender_cpu_seconds",
    "receiver_cpu_seconds",
    "sender_max_rss_kib",
    "receiver_max_rss_kib",
    "source_sha256",
    "received_sha256",
    "success"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "commit": { "type": ["string", "null"] },
    "working_tree_dirty": { "type": ["boolean", "null"] },
    "role": { "enum": ["sender", "receiver"] },
    "transport": { "enum": ["iroh", "webrtc", "croc"] },
    "transport_mode": { "enum": ["auto", "relay"] },
    "build_id": { "type": "string", "minLength": 1 },
    "sender_binary_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "receiver_binary_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "direction": { "enum": ["wsl-to-oracle", "oracle-to-wsl"] },
    "host_pair": { "type": "string", "minLength": 1 },
    "storage_class": { "type": "string", "minLength": 1 },
    "pairing_mode": { "enum": ["pake", "invite", "croc-secret"] },
    "profile_mode": { "enum": ["standard", "payload-profile"] },
    "stream_window_bytes": {
      "anyOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1250000, "maximum": 5000000 }
      ]
    },
    "experimental_protocol_version": { "type": "string", "minLength": 1 },
    "parallel_streams": { "type": "integer", "enum": [1, 4] },
    "payload_key_count": { "type": "integer", "const": 1 },
    "kem_sessions": { "type": "integer", "const": 1 },
    "source_staging": { "enum": ["per-trial", "pre-staged"] },
    "payload_profile": {
      "type": "object",
      "required": [
        "source_read_seconds",
        "allocation_copy_encrypt_seconds",
        "send_wait_seconds",
        "receive_wait_seconds",
        "decrypt_seconds",
        "destination_write_seconds",
        "chunk_count",
        "payload_bytes"
      ],
      "properties": {
        "source_read_seconds": { "type": "number", "minimum": 0 },
        "allocation_copy_encrypt_seconds": { "type": "number", "minimum": 0 },
        "sender_allocation_copy_seconds": { "type": "number", "minimum": 0 },
        "sender_encrypt_seconds": { "type": "number", "minimum": 0 },
        "send_wait_seconds": { "type": "number", "minimum": 0 },
        "receive_wait_seconds": { "type": "number", "minimum": 0 },
        "decrypt_seconds": { "type": "number", "minimum": 0 },
        "destination_write_seconds": { "type": "number", "minimum": 0 },
        "chunk_count": { "type": "integer", "minimum": 0 },
        "payload_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "path": { "enum": ["direct", "relay", "mixed", "unknown", "auto"] },
    "path_start": { "enum": ["direct", "relay", "unknown"] },
    "path_end": { "enum": ["direct", "relay", "unknown"] },
    "path_evidence": {
      "type": ["object", "null"],
      "properties": {
        "classification": { "enum": ["direct", "relay", "mixed", "unverified"] },
        "verified": { "type": "boolean" },
        "direct_stream_tx": { "type": "integer", "minimum": 0 },
        "direct_stream_rx": { "type": "integer", "minimum": 0 },
        "relay_stream_tx": { "type": "integer", "minimum": 0 },
        "relay_stream_rx": { "type": "integer", "minimum": 0 },
        "lagged": { "type": "boolean" },
        "missing_path_stats": { "type": "boolean" },
        "relay_selected": { "type": "boolean" },
        "connection_stats": {
          "type": "object",
          "properties": {
            "sample_interval_ms": { "type": "integer", "minimum": 1 },
            "sampling_mode": { "type": "string" },
            "samples": { "type": "integer", "minimum": 1 },
            "selected_path_start": { "type": ["string", "null"] },
            "selected_path_end": { "type": ["string", "null"] },
            "selected_path_differs_at_end": { "type": "boolean" },
            "rtt_start_us": { "type": ["integer", "null"], "minimum": 0 },
            "rtt_end_us": { "type": ["integer", "null"], "minimum": 0 },
            "rtt_min_us": { "type": ["integer", "null"], "minimum": 0 },
            "rtt_max_us": { "type": ["integer", "null"], "minimum": 0 },
            "congestion_window_start_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "congestion_window_end_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "congestion_window_min_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "congestion_window_max_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "congestion_events_start": { "type": ["integer", "null"], "minimum": 0 },
            "congestion_events_end": { "type": ["integer", "null"], "minimum": 0 },
            "congestion_events_delta": { "type": ["integer", "null"], "minimum": 0 },
            "lost_packets_start": { "type": "integer", "minimum": 0 },
            "lost_packets_end": { "type": "integer", "minimum": 0 },
            "lost_packets_delta": { "type": "integer", "minimum": 0 },
            "lost_bytes_start": { "type": "integer", "minimum": 0 },
            "lost_bytes_end": { "type": "integer", "minimum": 0 },
            "lost_bytes_delta": { "type": "integer", "minimum": 0 },
            "udp_tx_datagrams_delta": { "type": "integer", "minimum": 0 },
            "udp_tx_bytes_delta": { "type": "integer", "minimum": 0 },
            "udp_rx_datagrams_delta": { "type": "integer", "minimum": 0 },
            "udp_rx_bytes_delta": { "type": "integer", "minimum": 0 },
            "data_blocked_frames_delta": { "type": "integer", "minimum": 0 },
            "stream_data_blocked_frames_delta": { "type": "integer", "minimum": 0 },
            "data_blocked_frames_rx_delta": { "type": "integer", "minimum": 0 },
            "stream_data_blocked_frames_rx_delta": { "type": "integer", "minimum": 0 },
            "send_wait_calls": { "type": "integer", "minimum": 0 },
            "send_stalls_over_1ms": { "type": "integer", "minimum": 0 },
            "send_stalls_over_10ms": { "type": "integer", "minimum": 0 },
            "send_wait_max_us": { "type": "integer", "minimum": 0 },
            "unavailable_counters": { "type": "array", "items": { "type": "string" } },
            "counter_limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "direct_route_verified_both": { "type": "boolean" },
    "local_candidate_type": { "type": ["string", "null"] },
    "remote_candidate_type": { "type": ["string", "null"] },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "chunk_size": { "type": "integer", "minimum": 0 },
    "pipeline_depth": { "type": "integer", "minimum": 1 },
    "handshake_seconds": { "type": ["number", "null"], "minimum": 0 },
    "payload_seconds": { "type": ["number", "null"], "minimum": 0 },
    "shutdown_seconds": { "type": ["number", "null"], "minimum": 0 },
    "wall_seconds": { "type": "number", "minimum": 0 },
    "effective_mib_per_second": { "type": "number", "minimum": 0 },
    "sender_cpu_seconds": { "type": ["number", "null"], "minimum": 0 },
    "receiver_cpu_seconds": { "type": ["number", "null"], "minimum": 0 },
    "sender_max_rss_kib": { "type": ["integer", "null"], "minimum": 0 },
    "receiver_max_rss_kib": { "type": ["integer", "null"], "minimum": 0 },
    "source_sha256": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      ]
    },
    "received_sha256": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      ]
    },
    "bytes_transferred": { "type": "integer", "minimum": 0 },
    "success": { "type": "boolean" }
  }
}
