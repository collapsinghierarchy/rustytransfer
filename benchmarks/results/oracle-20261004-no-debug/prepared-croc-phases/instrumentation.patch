diff --git a/src/croc/benchmark_phases.go b/src/croc/benchmark_phases.go
new file mode 100644
index 0000000..e48ee12
--- /dev/null
+++ b/src/croc/benchmark_phases.go
@@ -0,0 +1,150 @@
+package croc
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"sync"
+	"time"
+)
+
+const benchmarkPhaseProfileEnv = "CROC_BENCH_PHASE_PROFILE"
+
+type benchmarkPhaseProfile struct {
+	mu sync.Mutex
+
+	role             string
+	started          time.Time
+	payloadAt        time.Time
+	payloadEnd       time.Time
+	prepStart        time.Time
+	prepEnd          time.Time
+	fileCloseSeconds float64
+}
+
+type benchmarkPhaseRecord struct {
+	SchemaVersion          int     `json:"schema_version"`
+	Role                   string  `json:"role"`
+	TotalSeconds           float64 `json:"total_seconds"`
+	SetupSeconds           float64 `json:"setup_seconds"`
+	PayloadSeconds         float64 `json:"payload_seconds"`
+	PayloadStartObserved   bool    `json:"payload_start_observed"`
+	PayloadEndObserved     bool    `json:"payload_end_observed"`
+	PreparationEndObserved bool    `json:"preparation_end_observed"`
+	CompletionSeconds      float64 `json:"completion_seconds"`
+	PreparationSeconds     float64 `json:"preparation_seconds"`
+	FileCloseSeconds       float64 `json:"file_close_seconds,omitempty"`
+	SetupBoundary          string  `json:"setup_boundary"`
+	PayloadEndBoundary     string  `json:"payload_end_boundary"`
+	PreparationOverlaps    bool    `json:"preparation_may_overlap_transfer"`
+}
+
+// newBenchmarkPhaseProfile is deliberately opt-in. When disabled, callers keep
+// a nil pointer, so profile methods do no timestamp, mutex, or JSON work. The
+// sender/receiver loops still check their local first-payload booleans.
+func newBenchmarkPhaseProfile(role string) *benchmarkPhaseProfile {
+	if os.Getenv(benchmarkPhaseProfileEnv) != "1" {
+		return nil
+	}
+	return &benchmarkPhaseProfile{role: role, started: time.Now()}
+}
+
+func (p *benchmarkPhaseProfile) startPayload() {
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	if p.payloadAt.IsZero() {
+		p.payloadAt = time.Now()
+	}
+	p.mu.Unlock()
+}
+
+// endPayload records the most recent data-queue completion. Sender queues are
+// per-file, so the final value is the last completed file's final Send return.
+func (p *benchmarkPhaseProfile) endPayload() {
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	if !p.payloadAt.IsZero() {
+		p.payloadEnd = time.Now()
+	}
+	p.mu.Unlock()
+}
+
+func (p *benchmarkPhaseProfile) startPreparation() {
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	if p.prepStart.IsZero() {
+		p.prepStart = time.Now()
+	}
+	p.mu.Unlock()
+}
+
+func (p *benchmarkPhaseProfile) endPreparation() {
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	if !p.prepStart.IsZero() && p.prepEnd.IsZero() {
+		p.prepEnd = time.Now()
+	}
+	p.mu.Unlock()
+}
+
+func (p *benchmarkPhaseProfile) recordFileClose(start time.Time) {
+	if p == nil || start.IsZero() {
+		return
+	}
+	p.mu.Lock()
+	p.fileCloseSeconds += time.Since(start).Seconds()
+	p.mu.Unlock()
+}
+
+func (p *benchmarkPhaseProfile) emit() {
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	finished := time.Now()
+	started, payloadAt, payloadEnd := p.started, p.payloadAt, p.payloadEnd
+	prepStart, prepEnd, role := p.prepStart, p.prepEnd, p.role
+	payloadStartObserved, payloadEndObserved := !payloadAt.IsZero(), !payloadEnd.IsZero()
+	preparationEndObserved := !prepEnd.IsZero()
+	fileCloseSeconds := p.fileCloseSeconds
+	p.mu.Unlock()
+
+	if payloadAt.IsZero() {
+		payloadAt = finished
+	}
+	if payloadEnd.IsZero() || payloadEnd.Before(payloadAt) {
+		payloadEnd = finished
+	}
+	record := benchmarkPhaseRecord{
+		SchemaVersion:          1,
+		Role:                   role,
+		TotalSeconds:           finished.Sub(started).Seconds(),
+		SetupSeconds:           payloadAt.Sub(started).Seconds(),
+		PayloadSeconds:         payloadEnd.Sub(payloadAt).Seconds(),
+		PayloadStartObserved:   payloadStartObserved,
+		PayloadEndObserved:     payloadEndObserved,
+		PreparationEndObserved: preparationEndObserved,
+		CompletionSeconds:      finished.Sub(payloadEnd).Seconds(),
+		SetupBoundary:          "sender first chunk claim; receiver first non-ping data frame",
+		PayloadEndBoundary:     "sender final per-file chunk-queue Send return; receiver all-files-ready after final file close/checks",
+		PreparationOverlaps:    role == "sender",
+		FileCloseSeconds:       fileCloseSeconds,
+	}
+	if !prepStart.IsZero() && !prepEnd.IsZero() {
+		record.PreparationSeconds = prepEnd.Sub(prepStart).Seconds()
+	}
+	encoded, err := json.Marshal(record)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "CROC_BENCH_PHASE_PROFILE_ERROR: %v\n", err)
+		return
+	}
+	fmt.Fprintf(os.Stderr, "CROC_BENCH_PHASE_PROFILE %s\n", encoded)
+}
diff --git a/src/croc/benchmark_phases_test.go b/src/croc/benchmark_phases_test.go
new file mode 100644
index 0000000..872bd59
--- /dev/null
+++ b/src/croc/benchmark_phases_test.go
@@ -0,0 +1,93 @@
+package croc
+
+import (
+	"encoding/json"
+	"io"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func captureBenchmarkPhaseRecord(t *testing.T, profile *benchmarkPhaseProfile) benchmarkPhaseRecord {
+	t.Helper()
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	oldStderr := os.Stderr
+	os.Stderr = writer
+	profile.emit()
+	if err := writer.Close(); err != nil {
+		os.Stderr = oldStderr
+		t.Fatal(err)
+	}
+	os.Stderr = oldStderr
+	raw, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const prefix = "CROC_BENCH_PHASE_PROFILE "
+	line := strings.TrimSpace(string(raw))
+	if !strings.HasPrefix(line, prefix) {
+		t.Fatalf("unexpected marker: %q", line)
+	}
+	var record benchmarkPhaseRecord
+	if err := json.Unmarshal([]byte(strings.TrimPrefix(line, prefix)), &record); err != nil {
+		t.Fatal(err)
+	}
+	return record
+}
+
+func TestBenchmarkPhaseProfileOptInDurationsAndConcurrentEnd(t *testing.T) {
+	t.Setenv(benchmarkPhaseProfileEnv, "0")
+	if got := newBenchmarkPhaseProfile("sender"); got != nil {
+		t.Fatal("profile should be disabled unless explicitly enabled")
+	}
+
+	t.Setenv(benchmarkPhaseProfileEnv, "1")
+	profile := newBenchmarkPhaseProfile("sender")
+	if profile == nil {
+		t.Fatal("profile should be enabled")
+	}
+	profile.startPreparation()
+	profile.startPayload()
+	profile.endPreparation()
+	profile.recordFileClose(profile.started)
+
+	var end sync.WaitGroup
+	end.Add(1)
+	go func() {
+		defer end.Done()
+		profile.endPayload()
+	}()
+	record := captureBenchmarkPhaseRecord(t, profile)
+	end.Wait()
+
+	if record.SchemaVersion != 1 || record.Role != "sender" {
+		t.Fatalf("unexpected profile identity: %+v", record)
+	}
+	if !record.PayloadStartObserved || !record.PreparationEndObserved {
+		t.Fatalf("expected observed start/preparation boundaries: %+v", record)
+	}
+	if record.TotalSeconds < 0 || record.SetupSeconds < 0 || record.PayloadSeconds < 0 || record.CompletionSeconds < 0 {
+		t.Fatalf("negative duration: %+v", record)
+	}
+	if record.SetupSeconds+record.PayloadSeconds+record.CompletionSeconds > record.TotalSeconds+1e-9 {
+		t.Fatalf("non-overlapping phases exceed total: %+v", record)
+	}
+	if record.PreparationSeconds < 0 || record.FileCloseSeconds < 0 {
+		t.Fatalf("negative subspan: %+v", record)
+	}
+}
+
+func TestBenchmarkPhaseProfileMarksUnobservedBoundaries(t *testing.T) {
+	t.Setenv(benchmarkPhaseProfileEnv, "1")
+	record := captureBenchmarkPhaseRecord(t, newBenchmarkPhaseProfile("receiver"))
+	if record.PayloadStartObserved || record.PayloadEndObserved || record.PreparationEndObserved {
+		t.Fatalf("empty operation reported an observed boundary: %+v", record)
+	}
+	if record.SetupSeconds < 0 || record.PayloadSeconds != 0 || record.CompletionSeconds != 0 {
+		t.Fatalf("unexpected fallback durations for unobserved payload: %+v", record)
+	}
+}
