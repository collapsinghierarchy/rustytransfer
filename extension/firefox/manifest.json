{
  "manifest_version": 3,
  "name": "RustyTransfer",
  "version": "0.1.0",
  "description": "Send files through the RustyTransfer desktop native host.",
  "icons": {
    "32": "icon.svg",
    "64": "icon.svg"
  },
  "permissions": [
    "nativeMessaging",
    "clipboardWrite",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": "icon.svg",
    "default_title": "RustyTransfer",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rustytransfer@collapsinghierarchy",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
